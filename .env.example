# Public URL this server is reachable at, no trailing slash.
BASE_URL=https://mcp-whoop.example.com

# GitHub OAuth app used to authenticate MCP clients. It is only the login
# screen: scope "user" (profile read), and the sole field used is your login.
# See README, "Why a GitHub OAuth app?", for why it is needed and how to swap
# it for Google or another provider.
# Callback URL to register with GitHub: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use this server.
# Leave empty and the server refuses to start — this is the only thing
# standing between your health data and the public internet.
ALLOWED_GITHUB_LOGINS=

# Stable secret for signing the tokens issued to MCP clients. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, every restart signs all clients out.
JWT_SIGNING_KEY=

# WHOOP developer app (https://developer.whoop.com/).
# Redirect URI to register with WHOOP: <BASE_URL>/oauth/callback
# The app's scopes must include "offline", or no refresh token is issued.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Guards the one-time /oauth/start bootstrap route. Any long random string.
SETUP_TOKEN=

# Where the WHOOP token is persisted.
DATA_DIR=/data

HOST=0.0.0.0
PORT=8000
